+    let inputCtx := doc.mkInputContext
+    let (headerStx, _, headerMsgs) ← Parser.parseHeader inputCtx
+    if headerMsgs.hasErrors then
+      IO.eprintln "LEAN_SERVER_SNAPSHOT fallback: header parse failed"
+      return (none, none)
+    let incr? ← try
+      some <$> Lean.Elab.loadIncrSnapshot path
+    catch e =>
+      IO.eprintln s!"LEAN_SERVER_SNAPSHOT fallback: load failed: {e}"
+      pure none
+    let some incr := incr?
+      | return (none, none)
+    let snap0 := incr.snap
